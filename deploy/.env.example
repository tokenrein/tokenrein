# ./setup.sh writes deploy/.env from this file with fresh secrets; or copy it and fill it in.
# Never commit the real file.

# Admin API and dashboard sign-in token, 16+ characters:  openssl rand -hex 24
TOKENREIN_ADMIN_TOKEN=
# Encrypts provider API keys saved in the dashboard, 64 hex characters:  openssl rand -hex 32
# Keep a copy somewhere safe: without it, saved provider keys cannot be decrypted.
TOKENREIN_SECRETS_KEY=

# Postgres password (used by the postgres container) and the matching connection URL.
POSTGRES_PASSWORD=
TOKENREIN_DATABASE_URL=postgres://tokenrein:<POSTGRES_PASSWORD>@postgres:5432/tokenrein

# The dashboard's address as people reach it: used in alert links, password setup links and
# single sign-on redirects. Use your HTTPS address in production.
TOKENREIN_PUBLIC_URL=http://127.0.0.1:8788

# Optional: provider keys for every org (they can also be saved per org in the dashboard).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: a Team or Enterprise license key (docs/licensing.md). It can also be pasted in the
# dashboard under Keys & limits.
# TOKENREIN_LICENSE=

# Optional: image and ports. If agents reach the proxy anywhere other than this host on port
# 8787, set TOKENREIN_PROXY_URL so the dashboard's connect commands use that address.
# TOKENREIN_IMAGE=ghcr.io/tokenrein/tokenrein:0.1.2
# TOKENREIN_PROXY_PORT=8787
# TOKENREIN_ADMIN_PORT=8788
# TOKENREIN_PROXY_URL=https://tokenrein.example.com:8787
